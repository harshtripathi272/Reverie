{
  "name": "@reverie/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:static": "node -e \"process.env.REVERIE_BUILD_MODE='static';require('child_process').spawnSync(process.platform==='win32'?'next.cmd':'next',['build'],{stdio:'inherit',env:process.env})\"",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.0",
    "@reverie/schema": "workspace:*",
    "d3-force-3d": "^3.0.5",
    "next": "^15.1.6",
    "postprocessing": "^6.36.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.171.0",
    "three-stdlib": "^2.34.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.171.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  }
